<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>City Hoops 2D</title>
    <style>
        :root {
            --primary: #ff6b1a;
            --bg-day: #87CEEB;
            --bg-night: #1a1a2e;
            --accent: #f1c40f;
            --bar-width: 140px; 
        }
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #222;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            user-select: none;
            touch-action: none;
        }
        #game-wrapper {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #333;
        }
        canvas {
            display: block;
            background: var(--bg-day);
            transition: background 0.5s ease;
        }
        #ui-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        #start-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
            pointer-events: auto;
            cursor: pointer;
            backdrop-filter: blur(4px);
        }
        #start-text {
            color: white;
            font-size: 24px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
            border: 3px solid var(--primary);
            padding: 20px 40px;
            border-radius: 10px;
            background: rgba(0,0,0,0.4);
        }
        
        .stats {
            position: absolute;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
            display: none; 
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
            z-index: 10;
            pointer-events: none;
            transition: opacity 0.2s;
            transform: translateX(-100%);
        }
        .bar-container {
            background: rgba(0,0,0,0.6);
            padding: 6px 10px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.2);
            backdrop-filter: blur(4px);
        }
        .bar-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            width: var(--bar-width);
            margin-bottom: 2px;
        }
        .bar-label {
            font-size: 9px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.9);
        }
        .bar-value {
            font-size: 11px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            color: var(--accent);
        }
        .bar-wrap {
            width: var(--bar-width);
            height: 10px;
            background: rgba(0,0,0,0.7);
            border: 1px solid rgba(255,255,255,0.5);
            border-radius: 2px;
            position: relative;
            overflow: hidden;
        }
        .bar-fill {
            height: 100%;
            width: 0%;
            position: relative;
        }
        #pwr-fill { background: linear-gradient(90deg, #ff4757, #ff6b1a, #ffa502); }
        #ang-fill { background: linear-gradient(90deg, #2ed573, #1e90ff, #5352ed); }
        
        #score-board {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 28px;
            font-weight: 900;
            color: white;
            font-family: 'Arial Black', sans-serif;
            text-shadow: 2px 2px 0px rgba(0,0,0,0.4);
            background: rgba(0,0,0,0.5);
            padding: 8px 18px;
            border-radius: 6px;
            border: 2px solid var(--primary);
        }

        /* Grouped Controls */
        #top-left-controls {
            position: absolute;
            top: 20px;
            left: 20px;
            pointer-events: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        #bottom-right-controls {
            position: absolute;
            bottom: 20px;
            right: 20px;
            pointer-events: auto;
        }
        
        #hint {
            position: absolute;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 4px black;
            opacity: 0.8;
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { opacity: 0.4; transform: translateX(-50%) scale(1); }
            50% { opacity: 1; transform: translateX(-50%) scale(1.05); }
            100% { opacity: 0.4; transform: translateX(-50%) scale(1); }
        }
        button {
            padding: 10px 20px;
            background: rgba(0,0,0,0.8);
            border: 2px solid white;
            color: white;
            cursor: pointer;
            border-radius: 6px;
            font-weight: bold;
            backdrop-filter: blur(8px);
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 11px;
            white-space: nowrap;
        }
        button:hover { background: var(--primary); color: white; border-color: var(--primary); }

        /* Music Modal Styles */
        #music-modal {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 200;
            pointer-events: auto;
            backdrop-filter: blur(10px);
        }
        .modal-content {
            background: #222;
            border: 2px solid var(--primary);
            padding: 30px;
            border-radius: 12px;
            width: 300px;
            text-align: center;
            color: white;
        }
        .modal-title {
            font-size: 20px;
            font-weight: 900;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .music-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .music-item {
            padding: 15px;
            background: #333;
            border: 1px solid #444;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: bold;
        }
        .music-item:hover { background: #444; border-color: var(--primary); }
        .music-item.selected { background: var(--primary); border-color: white; }
        #close-modal {
            margin-top: 20px;
            background: #555;
            border: none;
            width: 100%;
        }
    </style>
</head>
<body>

<div id="game-wrapper">
    <canvas id="gameCanvas"></canvas>
    
    <div id="start-overlay">
        <div id="start-text">Tap to Play</div>
    </div>

    <!-- Music Modal -->
    <div id="music-modal">
        <div class="modal-content">
            <div class="modal-title">Select Track</div>
            <div class="music-list">
                <div class="music-item selected" data-track="0">City Lo-Fi</div>
                <div class="music-item" data-track="1">Midnight Synth</div>
                <div class="music-item" data-track="2">Neon Drive</div>
            </div>
            <button id="close-modal">Back to Game</button>
        </div>
    </div>

    <div id="ui-overlay">
        <div id="floating-stats" class="stats">
            <div class="bar-container">
                <div class="bar-header">
                    <span class="bar-label">Power</span>
                    <span id="pwr-val" class="bar-value">0%</span>
                </div>
                <div class="bar-wrap">
                    <div id="pwr-fill" class="bar-fill"></div>
                </div>
            </div>
            <div class="bar-container">
                <div class="bar-header">
                    <span class="bar-label">Angle</span>
                    <span id="ang-val" class="bar-value">0°</span>
                </div>
                <div class="bar-wrap">
                    <div id="ang-fill" class="bar-fill"></div>
                </div>
            </div>
        </div>
        
        <div id="score-board">SCORE: 0</div>
        <div id="hint">Drag anywhere to aim</div>
        
        <div id="top-left-controls">
            <button id="openMusic">SELECT MUSIC</button>
            <button id="toggleMusic">MUSIC: ON</button>
        </div>

        <div id="bottom-right-controls">
            <button id="toggleDayNight">NIGHT MODE</button>
        </div>
    </div>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const floatingStats = document.getElementById('floating-stats');
const pwrFill = document.getElementById('pwr-fill');
const angFill = document.getElementById('ang-fill');
const pwrVal = document.getElementById('pwr-val');
const angVal = document.getElementById('ang-val');
const scoreBoard = document.getElementById('score-board');
const toggleBtn = document.getElementById('toggleDayNight');
const musicBtn = document.getElementById('toggleMusic');
const openMusicBtn = document.getElementById('openMusic');
const musicModal = document.getElementById('music-modal');
const closeModal = document.getElementById('close-modal');
const musicItems = document.querySelectorAll('.music-item');
const hint = document.getElementById('hint');
const startOverlay = document.getElementById('start-overlay');

// Game Settings
let width, height;
const gravity = 0.75; 
const friction = 0.996; 
const groundFriction = 0.88;
const bounce = 0.72;
let score = 0;
let isNight = false;
let musicEnabled = true;

// Slingshot State
let isAiming = false;
let startX = 0, startY = 0;
let dragX = 0, dragY = 0;
let launchVX = 0, launchVY = 0;
let currentPower = 0;
let currentAngle = 0;

const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
const mainGain = audioCtx.createGain();
mainGain.connect(audioCtx.destination);
mainGain.gain.value = 0.5;

// --- Procedural Music Engine ---
let musicStarted = false;
let currentTrackIndex = 0;
let currentStep = 0;

const tracks = [
    {
        name: "City Lo-Fi",
        tempo: 120,
        scale: [261.63, 293.66, 329.63, 392.00, 440.00, 523.25], // C Pentatonic
        bassNotes: [65.41, 73.42, 87.31, 98.00], // C, D, F, G
        melodyType: 'triangle',
        bassType: 'sine'
    },
    {
        name: "Midnight Synth",
        tempo: 100,
        scale: [233.08, 277.18, 311.13, 349.23, 415.30, 466.16], // Bb Minor Pentatonic
        bassNotes: [58.27, 69.30, 77.78, 92.50], // Bb, Db, Eb, Gb
        melodyType: 'sawtooth',
        bassType: 'triangle'
    },
    {
        name: "Neon Drive",
        tempo: 140,
        scale: [293.66, 329.63, 349.23, 392.00, 440.00, 493.88], // D Dorian
        bassNotes: [73.42, 82.41, 98.00, 110.00], // D, E, G, A
        melodyType: 'square',
        bassType: 'sawtooth'
    }
];

function playNote(freq, type, vol, duration, time) {
    if (!musicEnabled) return;
    const osc = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, time);
    g.gain.setValueAtTime(vol, time);
    g.gain.exponentialRampToValueAtTime(0.001, time + duration);
    osc.connect(g);
    g.connect(mainGain);
    osc.start(time);
    osc.stop(time + duration);
}

function startBackgroundMusic() {
    if (musicStarted) return;
    musicStarted = true;
    
    function scheduler() {
        const track = tracks[currentTrackIndex];
        const stepDuration = 60 / track.tempo / 2;
        const now = audioCtx.currentTime;
        const scheduleAhead = 0.1;
        
        // Bassline
        if (currentStep % 4 === 0) {
            const b = track.bassNotes[Math.floor(currentStep / 16) % track.bassNotes.length];
            playNote(b, track.bassType, 0.25, 0.6, now + scheduleAhead);
        }

        // Percussion
        if (currentStep % 2 === 0) {
            const vol = (currentStep % 4 === 0) ? 0.04 : 0.015;
            playNote(800, 'sine', vol, 0.04, now + scheduleAhead);
        }

        // Melody
        if (Math.random() > 0.5 && currentStep % 2 === 1) {
            const note = track.scale[Math.floor(Math.random() * track.scale.length)];
            const vol = track.melodyType === 'square' ? 0.03 : 0.08;
            playNote(note, track.melodyType, vol, 0.35, now + scheduleAhead);
        }

        currentStep = (currentStep + 1) % 64; 
        setTimeout(scheduler, stepDuration * 1000);
    }
    
    scheduler();
}

// --- UI Interaction Handlers ---

startOverlay.addEventListener('click', () => {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    startOverlay.style.display = 'none';
    startBackgroundMusic();
});

openMusicBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    musicModal.style.display = 'flex';
});

closeModal.addEventListener('click', (e) => {
    e.stopPropagation();
    musicModal.style.display = 'none';
});

musicItems.forEach(item => {
    item.addEventListener('click', (e) => {
        e.stopPropagation();
        musicItems.forEach(i => i.classList.remove('selected'));
        item.classList.add('selected');
        currentTrackIndex = parseInt(item.dataset.track);
        currentStep = 0; // Reset rhythm on track change
    });
});

musicBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    musicEnabled = !musicEnabled;
    musicBtn.innerText = musicEnabled ? 'MUSIC: ON' : 'MUSIC: OFF';
    mainGain.gain.setTargetAtTime(musicEnabled ? 0.5 : 0, audioCtx.currentTime, 0.1);
});

toggleBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    isNight = !isNight;
    canvas.style.background = isNight ? 'var(--bg-night)' : 'var(--bg-day)';
    toggleBtn.innerText = isNight ? 'DAY MODE' : 'NIGHT MODE';
});

// --- Sound Effects and Ball Logic ---

function playSound(freq, type, duration, vol = 0.2, slideTo = null, noise = false) {
    if (audioCtx.state !== 'running') return;
    try {
        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(vol, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        
        if (noise) {
            const bufferSize = audioCtx.sampleRate * duration;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
            const source = audioCtx.createBufferSource();
            source.buffer = buffer;
            const filter = audioCtx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(freq, audioCtx.currentTime);
            source.connect(filter);
            filter.connect(gain);
            gain.connect(mainGain);
            source.start();
        } else {
            const osc = audioCtx.createOscillator();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            if (slideTo) {
                osc.frequency.exponentialRampToValueAtTime(slideTo, audioCtx.currentTime + duration);
            }
            osc.connect(gain);
            gain.connect(mainGain);
            osc.start();
            osc.stop(audioCtx.currentTime + duration);
        }
    } catch(e) {}
}

const sfx = {
    bounce: (v = 1.0) => playSound(80, 'sine', 0.25, 0.6 * v, 30),
    rim: () => playSound(1200, 'triangle', 0.15, 0.65, 100),
    backboard: () => playSound(140, 'square', 0.2, 0.4, 80),
    swish: () => playSound(800, 'sine', 0.25, 0.6, 400, true),
    air: () => playSound(2000, 'sine', 0.6, 0.8, 500, true),
    wall: () => playSound(110, 'square', 0.15, 0.5, 70)
};

const ball = {
    x: 220, y: 0,
    radius: 20, 
    vx: 0, vy: 0,
    isFlying: false,
    rotation: 0,
    scored: false,
    respawnTimer: null,
    reset() {
        if (this.respawnTimer) {
            clearTimeout(this.respawnTimer);
            this.respawnTimer = null;
        }
        const minSpawn = 100;
        const maxSpawn = Math.min(width * 0.45, 500);
        this.x = minSpawn + Math.random() * (maxSpawn - minSpawn);
        this.y = height - 70; 
        this.vx = 0;
        this.vy = 0;
        this.isFlying = false;
        this.rotation = 0;
        this.scored = false;
        hint.style.display = 'block';
        floatingStats.style.display = 'none'; 
    }
};

const hoop = {
    x: 0, y: 0,
    width: 70, 
    rimY: 0,
    backboardX: 0,
    netAnimate: 0,
    backboardW: 10,
    backboardH: 120
};

let particles = [];
let windParticles = [];

function createDust(x, y, count = 8) {
    for(let i=0; i<count; i++) {
        particles.push({
            x, y,
            vx: (Math.random() - 0.5) * 6,
            vy: -Math.random() * 5,
            life: 1.0,
            size: 2.5,
            color: isNight ? '#444' : '#bbb'
        });
    }
}

function createSparks(x, y, count = 12, type = 'rim') {
    for(let i=0; i<count; i++) {
        const speed = 2 + Math.random() * 5;
        const angle = Math.random() * Math.PI * 2;
        particles.push({
            x, y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 1.0,
            size: type === 'rim' ? 1 + Math.random() * 2 : 2 + Math.random() * 3,
            color: type === 'rim' ? (Math.random() > 0.5 ? '#f1c40f' : '#ff6b1a') : '#ecf0f1',
            glow: type === 'rim'
        });
    }
}

function createWind(x, y, vx, vy) {
    const speed = Math.hypot(vx, vy);
    const count = Math.min(12, Math.floor(speed * 0.8));
    for(let i=0; i<count; i++) {
        windParticles.push({
            x: x + (Math.random() - 0.5) * 15,
            y: y + (Math.random() - 0.5) * 15,
            vx: vx * 0.2 + (Math.random() - 0.5) * 2,
            vy: vy * 0.2 + (Math.random() - 0.5) * 2,
            life: 0.8,
            size: 0.5 + Math.random() * 1.5,
            isStreak: Math.random() > 0.7 
        });
    }
}

let buildings = [];
function initBuildings() {
    buildings = [];
    const count = Math.ceil(width / 180) + 1;
    for(let i=0; i<count; i++) {
        buildings.push({
            x: i * 180,
            width: 130 + Math.random() * 30,
            height: 300 + Math.random() * 300,
            color: ['#34495e', '#2980b9', '#c0392b', '#16a085', '#27ae60'][Math.floor(Math.random() * 5)],
            windows: Array.from({length: 15}, () => Math.random() > 0.4)
        });
    }
}

function updateUI(pwr, ang) {
    pwrFill.style.width = pwr + '%';
    angFill.style.width = (ang / 180) * 100 + '%';
    pwrVal.innerText = Math.round(pwr) + '%';
    angVal.innerText = Math.round(ang) + '°';
    floatingStats.style.left = (startX) + 'px';
    floatingStats.style.top = (startY - 60) + 'px';
}

function resize() {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;
    hoop.backboardX = width - 40; 
    hoop.x = hoop.backboardX - hoop.width - 15;
    hoop.y = height * 0.12; 
    hoop.rimY = hoop.y + 85;
    initBuildings();
    ball.reset();
}

function getPointerPos(e) {
    const rect = canvas.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return { x: clientX - rect.left, y: clientY - rect.top };
}

function handleStart(e) {
    if (ball.isFlying || startOverlay.style.display !== 'none' || musicModal.style.display === 'flex') return;
    const pos = getPointerPos(e);
    isAiming = true;
    startX = pos.x;
    startY = pos.y;
    dragX = pos.x;
    dragY = pos.y;
    hint.style.display = 'none';
    floatingStats.style.display = 'flex'; 
}

function handleMove(e) {
    if (!isAiming) return;
    const pos = getPointerPos(e);
    dragX = pos.x;
    dragY = pos.y;
    const dx = startX - dragX;
    const dy = startY - dragY;
    const dist = Math.min(Math.hypot(dx, dy), 300); 
    const angleRad = Math.atan2(dy, dx);
    currentPower = (dist / 300) * 100;
    let displayAngle = -(angleRad * 180 / Math.PI);
    if (displayAngle < 0) displayAngle += 360; 
    displayAngle = Math.max(0, Math.min(180, displayAngle));
    updateUI(currentPower, displayAngle);
    launchVX = Math.cos(angleRad) * (dist * 0.2);
    launchVY = Math.sin(angleRad) * (dist * 0.2);
}

function handleEnd() {
    if (!isAiming) return;
    isAiming = false;
    floatingStats.style.display = 'none'; 
    if (currentPower > 5) {
        ball.vx = launchVX;
        ball.vy = launchVY;
        ball.isFlying = true;
        sfx.air();
        createWind(ball.x, ball.y, ball.vx, ball.vy);
    } else {
        hint.style.display = 'block';
    }
}

canvas.addEventListener('mousedown', handleStart);
window.addEventListener('mousemove', handleMove);
window.addEventListener('mouseup', handleEnd);
canvas.addEventListener('touchstart', (e) => { e.preventDefault(); handleStart(e); });
window.addEventListener('touchmove', (e) => { e.preventDefault(); handleMove(e); });
window.addEventListener('touchend', handleEnd);

function update() {
    if (ball.isFlying) {
        ball.vx *= friction;
        ball.vy += gravity;
        ball.x += ball.vx;
        ball.y += ball.vy;
        ball.rotation += ball.vx * 0.08;

        if (Math.hypot(ball.vx, ball.vy) > 10) {
             if (Math.random() > 0.7) createWind(ball.x, ball.y, -ball.vx, -ball.vy);
        }

        const floorTopY = height - 50; 
        if (ball.y + ball.radius > floorTopY) {
            ball.y = floorTopY - ball.radius;
            ball.vy *= -bounce;
            ball.vx *= groundFriction;
            if (Math.abs(ball.vy) > 0.4) {
                sfx.bounce(Math.min(1, Math.abs(ball.vy)/10));
                createDust(ball.x, ball.y + ball.radius, 4);
            }
        }

        if (ball.x - ball.radius < 0) {
            ball.vx *= -bounce;
            ball.x = ball.radius;
            sfx.wall();
        }

        if (ball.x + ball.radius > width - 40) {
            ball.vx *= -bounce;
            ball.x = width - 40 - ball.radius;
            sfx.wall();
        }

        if (ball.x + ball.radius > hoop.backboardX - hoop.backboardW && ball.x - ball.radius < hoop.backboardX) {
            if (ball.y > hoop.y && ball.y < hoop.y + hoop.backboardH) {
                ball.vx *= -bounce;
                ball.x = hoop.backboardX - hoop.backboardW - ball.radius;
                sfx.backboard();
                createSparks(ball.x + ball.radius, ball.y, 10, 'board');
            }
        }

        const rims = [{ x: hoop.x, y: hoop.rimY }, { x: hoop.x + hoop.width, y: hoop.rimY }];
        rims.forEach(rim => {
            const dist = Math.hypot(ball.x - rim.x, ball.y - rim.y);
            if (dist < ball.radius + 4) {
                const bAngle = Math.atan2(ball.y - rim.y, ball.x - rim.x);
                const speed = Math.hypot(ball.vx, ball.vy);
                ball.vx = Math.cos(bAngle) * speed * 0.75;
                ball.vy = Math.sin(bAngle) * speed * 0.75;
                sfx.rim();
                createSparks(rim.x, rim.y, 15, 'rim');
            }
        });

        if (!ball.scored && ball.vy > 0 && 
            ball.x > hoop.x + 5 && ball.x < hoop.x + hoop.width - 5 &&
            ball.y > hoop.rimY - 5 && ball.y < hoop.rimY + 15) {
            score++;
            ball.scored = true;
            hoop.netAnimate = 40;
            scoreBoard.innerText = "SCORE: " + score;
            sfx.swish();
            createWind(ball.x, ball.y, 0, 10);
        }

        const isOffScreen = ball.y > height + 200 || ball.x < -100 || ball.x > width + 100;
        const speed = Math.hypot(ball.vx, ball.vy);
        const isStoppedOnGround = (speed < 0.35 && ball.y > height - 80);
        
        if ((isOffScreen || isStoppedOnGround) && !ball.respawnTimer) {
            ball.respawnTimer = setTimeout(() => { 
                const finalSpeed = Math.hypot(ball.vx, ball.vy);
                if (finalSpeed < 0.4 || ball.y > height + 100) {
                    ball.reset();
                } else {
                    ball.respawnTimer = null; 
                }
            }, isStoppedOnGround ? 600 : 200);
        }
    }

    particles.forEach((p, i) => {
        p.x += p.vx; p.y += p.vy; p.life -= 0.03;
        if (p.life <= 0) particles.splice(i, 1);
    });
    
    windParticles.forEach((p, i) => {
        p.x += p.vx; p.y += p.vy; p.life -= 0.05; 
        if (p.life <= 0) windParticles.splice(i, 1);
    });

    if (hoop.netAnimate > 0) hoop.netAnimate -= 2.5;
}

function drawAim() {
    if (!isAiming) return;
    ctx.strokeStyle = 'rgba(255,255,255,0.4)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(startX, startY, 15, 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([4, 4]);
    ctx.beginPath(); 
    ctx.moveTo(startX, startY); 
    ctx.lineTo(dragX, dragY); 
    ctx.stroke();
    ctx.setLineDash([]);

    let px = ball.x, py = ball.y;
    let pvx = launchVX, pvy = launchVY;
    for(let i=0; i<140; i++) { 
        pvx *= friction;
        pvy += gravity;
        px += pvx;
        py += pvy;
        if (py > height - 50 || px > width - 40 || px < 0) break;
        if (i % 2 === 0) {
            const alpha = Math.max(0, 0.8 - (i / 140));
            ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
            ctx.beginPath();
            ctx.arc(px, py, Math.max(1, 3.5 - (i*0.02)), 0, Math.PI*2);
            ctx.fill();
        }
    }
}

function drawBackground() {
    const skyGrd = ctx.createLinearGradient(0, 0, 0, height);
    if (isNight) {
        skyGrd.addColorStop(0, '#0f0c29'); skyGrd.addColorStop(1, '#302b63');
    } else {
        skyGrd.addColorStop(0, '#87CEEB'); skyGrd.addColorStop(1, '#e0f7fa');
    }
    ctx.fillStyle = skyGrd;
    ctx.fillRect(0, 0, width, height);
    ctx.fillStyle = isNight ? '#f5f3ce' : '#fff59d';
    ctx.beginPath(); 
    ctx.arc(isNight ? 120 : width - 150, 100, 45, 0, Math.PI*2); 
    ctx.fill();

    buildings.forEach(b => {
        ctx.fillStyle = isNight ? '#0a0a0a' : b.color;
        ctx.fillRect(b.x, height - b.height, b.width, b.height);
        const winCol = isNight ? '#f1c40f' : 'rgba(255,255,255,0.3)';
        ctx.fillStyle = winCol;
        for(let r=0; r<12; r++) {
            for(let c=0; c<2; c++) {
                if (!isNight || b.windows[r + c]) ctx.fillRect(b.x + 25 + c * (b.width/2.5), height - b.height + 40 + r * 45, 18, 22);
            }
        }
    });

    const floorY = height - 50;
    ctx.fillStyle = isNight ? '#1a1a1a' : '#444';
    ctx.fillRect(0, floorY, width, 50);
    ctx.strokeStyle = isNight ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.1)';
    ctx.lineWidth = 1;
    for(let i=0; i<width; i+=100) {
        ctx.beginPath(); ctx.moveTo(i, floorY); ctx.lineTo(i, height); ctx.stroke();
    }
    ctx.beginPath(); ctx.moveTo(0, floorY); ctx.lineTo(width, floorY); ctx.stroke();
    ctx.fillStyle = isNight ? '#3a1a0a' : '#6b3513';
    ctx.fillRect(width - 40, 0, 40, floorY);
    ctx.strokeStyle = 'rgba(0,0,0,0.3)';
    const brickH = 12;
    for(let y = 0; y < floorY; y += brickH) {
        ctx.beginPath(); ctx.moveTo(width - 40, y); ctx.lineTo(width, y); ctx.stroke();
    }
}

function drawBall() {
    ctx.save();
    ctx.translate(ball.x, ball.y);
    ctx.rotate(ball.rotation);
    const grd = ctx.createRadialGradient(-ball.radius*0.3, -ball.radius*0.3, 2, 0, 0, ball.radius);
    grd.addColorStop(0, '#ff9f43');
    grd.addColorStop(0.7, '#e67e22');
    grd.addColorStop(1, '#a04000');
    ctx.fillStyle = grd;
    ctx.beginPath(); ctx.arc(0, 0, ball.radius, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = 'rgba(0,0,0,0.9)';
    ctx.lineWidth = 1.8;
    ctx.beginPath(); ctx.moveTo(-ball.radius, 0); ctx.lineTo(ball.radius, 0); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(0, -ball.radius); ctx.lineTo(0, ball.radius); ctx.stroke();
    ctx.beginPath();
    ctx.arc(-ball.radius * 1.5, 0, ball.radius * 1.15, -0.65, 0.65);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(ball.radius * 1.5, 0, ball.radius * 1.15, Math.PI - 0.65, Math.PI + 0.65);
    ctx.stroke();
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(0, 0, ball.radius, 0, Math.PI * 2); ctx.stroke();
    ctx.restore();
}

function drawHoop(phase) {
    if (phase === 'back') {
        ctx.fillStyle = '#555';
        ctx.fillRect(hoop.backboardX - 4, hoop.y + 70, 4, (height - 50) - (hoop.y + 70));
        ctx.fillStyle = 'white';
        ctx.fillRect(hoop.backboardX - hoop.backboardW, hoop.y, hoop.backboardW, hoop.backboardH);
        ctx.strokeStyle = '#e74c3c';
        ctx.lineWidth = 2.5;
        ctx.strokeRect(hoop.backboardX - hoop.backboardW, hoop.rimY - 40, hoop.backboardW, 35);
        drawNetBack();
    } else if (phase === 'front') {
        drawNetFront();
        ctx.strokeStyle = '#ff6b1a';
        ctx.lineWidth = 6;
        ctx.lineCap = 'round';
        ctx.beginPath(); ctx.moveTo(hoop.x, hoop.rimY); ctx.lineTo(hoop.x + hoop.width, hoop.rimY); ctx.stroke();
    }
}

function drawNetBack() {
    const netH = 80;
    const sway = Math.sin(Date.now() * 0.012) * hoop.netAnimate * 0.4;
    ctx.fillStyle = isNight ? 'rgba(100, 100, 100, 0.2)' : 'rgba(200, 200, 200, 0.35)';
    ctx.beginPath();
    ctx.moveTo(hoop.x, hoop.rimY);
    ctx.lineTo(hoop.x + hoop.width, hoop.rimY);
    ctx.lineTo(hoop.x + hoop.width - 10 + sway, hoop.rimY + netH);
    ctx.lineTo(hoop.x + 10 + sway, hoop.rimY + netH);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.4)';
    ctx.lineWidth = 1.0;
    for(let i=0; i<=4; i++) {
        const topX = hoop.x + (hoop.width * (i/4));
        const bottomX = hoop.x + 10 + (hoop.width - 20) * (i/4) + sway;
        ctx.beginPath();
        ctx.moveTo(topX, hoop.rimY);
        ctx.lineTo(bottomX, hoop.rimY + netH);
        ctx.stroke();
    }
}

function drawNetFront() {
    const netH = 80;
    const sway = Math.sin(Date.now() * 0.012) * hoop.netAnimate * 0.4;
    ctx.strokeStyle = 'rgba(255,255,255,0.85)';
    ctx.lineWidth = 1.8;
    for(let i=0; i<=4; i++) {
        const topX = hoop.x + (hoop.width * (i/4));
        const bottomX = hoop.x + 10 + (hoop.width - 20) * (i/4) + sway;
        ctx.beginPath();
        ctx.moveTo(topX, hoop.rimY);
        ctx.lineTo(bottomX, hoop.rimY + netH);
        ctx.stroke();
    }
    for(let i=1; i<=4; i++) {
        const t = i / 4;
        const y = hoop.rimY + (netH * t);
        const currentWidth = hoop.width - (20 * t);
        const startX = hoop.x + (10 * t) + (sway * t);
        ctx.beginPath();
        ctx.moveTo(startX, y);
        ctx.lineTo(startX + currentWidth, y);
        ctx.stroke();
    }
}

function render() {
    ctx.clearRect(0, 0, width, height);
    drawBackground();
    
    particles.forEach(p => {
        ctx.save();
        ctx.globalAlpha = p.life; 
        ctx.fillStyle = p.color;
        if (p.glow) {
            ctx.shadowBlur = 10;
            ctx.shadowColor = p.color;
        }
        ctx.beginPath(); 
        ctx.arc(p.x, p.y, p.size, 0, Math.PI*2); 
        ctx.fill();
        ctx.restore();
    });

    windParticles.forEach(p => {
        ctx.save();
        ctx.globalAlpha = p.life * 0.5;
        ctx.strokeStyle = isNight ? 'rgba(255,255,255,0.4)' : 'rgba(255,255,255,0.7)';
        ctx.lineWidth = p.size;
        ctx.beginPath();
        if (p.isStreak) {
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p.x - p.vx * 1.5, p.y - p.vy * 1.5);
        } else {
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        }
        ctx.stroke();
        ctx.restore();
    });
    
    ctx.globalAlpha = 1.0;
    drawAim();
    drawHoop('back');
    drawBall();
    drawHoop('front'); 
    update();
    requestAnimationFrame(render);
}

window.addEventListener('resize', resize);
resize();
render();
</script>
</body>
</html>
